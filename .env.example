# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA - IVEKBOT WEATHER STATION
# ==============================================================================

# Entorno y Servidor — NOTA: ENVIRONMENT/PORT/HOST son TO-BE (hoy no se leen; uvicorn usa CLI)
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# PROVEEDOR DE LLM (Provider-Agnostic) — REQUIERE python-dotenv (ver requirements.txt)
# Sin load_dotenv(), `cp .env.example .env` NO surte efecto.
# Compatible con: OpenAI, Gemini, Anthropic, DeepSeek, Groq, OpenRouter, Mistral,
# u Ollama/vLLM/LM Studio local (OpenAI-compatible /v1/chat/completions).
# ------------------------------------------------------------------------------
# LLM_PROVIDER es solo etiqueta informativa (no cambia el gateway; ver orchestrator.py)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=tu_api_key_aqui

# Modelos y límites — SÍ tienen efecto (orquestador los lee; defaults si faltan: 250/300 y 0.3)
ORCHESTRATOR_MODEL=gpt-4o-mini
ORCHESTRATOR_MAX_TOKENS=250
ORCHESTRATOR_TEMPERATURE=0.3

RISK_AGENT_MODEL=gpt-4o-mini
RISK_AGENT_MAX_TOKENS=300
RISK_AGENT_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# BASE DE DATOS Y MENSAJERÍA — TO-BE: ningún módulo las consume hoy (app en memoria)
# Mantener para despliegue futuro con TimescaleDB/Redis/MQTT.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://ivek_user:ivek_pass@timescaledb:5432/weather_db
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_HOST=mqtt_broker
MQTT_BROKER_PORT=1883

# ------------------------------------------------------------------------------
# GRAPHIFY / GRAPHRAG — TO-BE: build_graph.py usa default 1500; no lee esta var hoy.
# ------------------------------------------------------------------------------
GRAPHIFY_TOKEN_BUDGET=1500
