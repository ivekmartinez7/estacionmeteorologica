# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA - IVEKBOT WEATHER STATION
# ==============================================================================

# Entorno y Servidor
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# PROVEEDOR DE LLM (Configurable por el Usuario / Provider-Agnostic)
# Compatible con cualquier API estándar (OpenAI, Gemini, Anthropic, DeepSeek,
# Groq, OpenRouter, Mistral) o servidores locales (Ollama, vLLM, LM Studio).
# ------------------------------------------------------------------------------
# Ejemplos de LLM_PROVIDER: "openai", "openrouter", "deepseek", "groq", "ollama", "custom"
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=tu_api_key_aqui

# Modelo para el Orquestador Master (Razonamiento / Plan-and-Execute)
ORCHESTRATOR_MODEL=gpt-4o-mini
ORCHESTRATOR_MAX_TOKENS=2000
ORCHESTRATOR_TEMPERATURE=0.2

# Modelo para Síntesis de Riesgo y Alertas Ciudadanas
RISK_AGENT_MODEL=gpt-4o-mini
RISK_AGENT_MAX_TOKENS=1000
RISK_AGENT_TEMPERATURE=0.4

# ------------------------------------------------------------------------------
# BASE DE DATOS Y MENSAJERÍA
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://ivek_user:ivek_pass@timescaledb:5432/weather_db
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_HOST=mqtt_broker
MQTT_BROKER_PORT=1883

# ------------------------------------------------------------------------------
# GRAPHIFY / GRAPHRAG CONFIGURATION
# ------------------------------------------------------------------------------
GRAPHIFY_TOKEN_BUDGET=1500
